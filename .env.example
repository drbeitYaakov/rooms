# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educational_scheduling
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=educational-scheduling-system
JWT_AUDIENCE=educational-scheduling-app
BRIDGE_TOKEN_SHARED_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
BRIDGE_TOKEN_EXPIRES_IN=10m
ENABLE_PUBLIC_REGISTRATION=false
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Application Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Queue Configuration
QUEUE_REDIS_URL=redis://localhost:6379

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
