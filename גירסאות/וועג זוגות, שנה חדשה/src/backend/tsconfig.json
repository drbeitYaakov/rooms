{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/backend",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@/*": ["*"],
      "@/domain/*": ["domain/*"],
      "@/infrastructure/*": ["infrastructure/*"],
      "@/api/*": ["api/*"],
      "@/utils/*": ["utils/*"],
      "@/config/*": ["config/*"],
      "@/middleware/*": ["middleware/*"]
    }
  },
  "include": ["**/*"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}